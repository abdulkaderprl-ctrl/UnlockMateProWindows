<UserControl x:Class="UnlockMatePro.Views.ScreenshotGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Screenshot &amp; Screen Recording Gallery" Style="{StaticResource HeaderTextBlock}" VerticalAlignment="Center" Margin="0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource FluentButton}" Command="{Binding OpenGalleryFolderCommand}" Margin="0,0,8,0">
                        <TextBlock Text="Open Pictures Folder" />
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CaptureScreenshotCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDevice}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Capture Screenshot" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Active Image Preview Container -->
            <Border Style="{StaticResource FluentCard}">
                <Grid Height="340" Background="#161616">
                    <Image Source="{Binding SelectedImagePath}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Gallery Thumbnails List -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <TextBlock Text="Saved Screenshots" Style="{StaticResource SubHeaderTextBlock}" />
                    <ListBox ItemsSource="{Binding GalleryImages}" SelectedItem="{Binding SelectedImagePath}" Height="120"
                             >
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4" Padding="4" Background="#262626" CornerRadius="4">
                                    <TextBlock Text="{Binding}" Width="160" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="White" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

