<UserControl x:Class="UnlockMatePro.Views.ScrcpyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Screen Mirroring &amp; Remote Control (Scrcpy)" Style="{StaticResource HeaderTextBlock}" />

            <!-- Launch Mirroring Banner Card -->
            <Border Style="{StaticResource FluentCard}" Background="#220078D4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="🖥️ Live Screen Mirroring" FontSize="18" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource FluentButton}" Command="{Binding StopMirroringCommand}" Margin="0,0,8,0">
                            <TextBlock Text="Stop Session" Foreground="{DynamicResource ErrorBrush}" />
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartMirroringCommand}" Padding="20,10">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDevice}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Start Screen Mirroring" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Mirroring & Control Preferences -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <TextBlock Text="Remote Control &amp; Display Preferences" Style="{StaticResource SubHeaderTextBlock}" />

                    <WrapPanel Margin="0,8,0,12">
                        <CheckBox Content="Enable Mouse &amp; Keyboard Input Control" IsChecked="{Binding IsControlEnabled}" Foreground="White" Margin="0,0,24,10" FontWeight="SemiBold" />
                        <CheckBox Content="Stay Awake (Keep device screen awake)" IsChecked="{Binding IsStayAwake}" Foreground="White" Margin="0,0,24,10" />
                        <CheckBox Content="Turn Device Screen Off while Mirroring" IsChecked="{Binding IsTurnScreenOff}" Foreground="White" Margin="0,0,24,10" />
                        <CheckBox Content="Show Physical Touch Dots on Display" IsChecked="{Binding IsShowTouches}" Foreground="White" Margin="0,0,0,10" />
                    </WrapPanel>

                    <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Max Frame Rate:" Foreground="White" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" SelectedValue="{Binding MaxFps, Mode=TwoWay}" SelectedValuePath="Tag" Background="#262626" Foreground="White" Padding="8,4">
                            <ComboBoxItem Content="30 FPS" Tag="30" />
                            <ComboBoxItem Content="60 FPS (Default)" Tag="60" />
                            <ComboBoxItem Content="90 FPS (High Smoothness)" Tag="90" />
                            <ComboBoxItem Content="120 FPS" Tag="120" />
                        </ComboBox>

                        <TextBlock Grid.Column="3" Text="Video Bitrate:" Foreground="White" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="4" SelectedValue="{Binding Bitrate, Mode=TwoWay}" SelectedValuePath="Tag" Background="#262626" Foreground="White" Padding="8,4">
                            <ComboBoxItem Content="4 Mbps (Low Bandwidth)" Tag="4M" />
                            <ComboBoxItem Content="8 Mbps (Balanced)" Tag="8M" />
                            <ComboBoxItem Content="16 Mbps (High Quality)" Tag="16M" />
                            <ComboBoxItem Content="32 Mbps (Ultra Crisp)" Tag="32M" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Screen Recording Tool Card -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <TextBlock Text="🎥 High Quality Screen Video Recording" Style="{StaticResource SubHeaderTextBlock}" />
                    <TextBlock Text="Record live video of your phone screen directly into an MP4 file on your computer." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,12" />

                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartRecordingCommand}" HorizontalAlignment="Left" Padding="20,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLogs}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Start Screen Recording to MP4" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

