<UserControl x:Class="UnlockMatePro.Views.AdbToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:UnlockMatePro.Views"
             xmlns:vm="clr-namespace:UnlockMatePro.ViewModels">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:DeviceInfoViewModel}">
            <views:DeviceInfoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceMonitorViewModel}">
            <views:DeviceMonitorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogcatViewModel}">
            <views:LogcatView />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <TabControl Style="{StaticResource FluentTabControl}">
            <!-- 1. Multi Device / Info -->
            <TabItem Header="Device Info">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ContentControl Content="{Binding DeviceInfoVM}" Grid.Row="0" />
                    <ContentControl Content="{Binding DeviceMonitorVM}" Grid.Row="1" />
                </Grid>
            </TabItem>
            
            <!-- 2. Package Manager -->
            <TabItem Header="Package Manager">
                <ContentControl Content="{Binding ApkManagementVM}" />
            </TabItem>
            
            <!-- 3. Shell Terminal -->
            <TabItem Header="Shell Terminal">
                <ContentControl Content="{Binding TerminalVM}" />
            </TabItem>
            
            <!-- 3.5 Logcat Viewer -->
            <TabItem Header="Logcat Viewer">
                <ContentControl Content="{Binding LogcatVM}" />
            </TabItem>
            
            <!-- 4. File Explorer -->
            <TabItem Header="File Explorer">
                <ContentControl Content="{Binding FileExplorerVM}" />
            </TabItem>
            
            <!-- 5. Advanced / Reboot / Screen / Wireless -->
            <TabItem Header="Advanced Tools">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- Wireless ADB Tool Card -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="📶 Wireless ADB" Style="{StaticResource SubHeaderTextBlock}" />
                                <TextBlock Text="Enable TCP/IP mode and connect wirelessly without USB cables." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource FluentButton}" Command="{Binding EnableWirelessAdbCommand}" Margin="0,0,8,0">
                                        <TextBlock Text="Enable TCPIP Mode" FontSize="12" />
                                    </Button>
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConnectWirelessAdbCommand}">
                                        <TextBlock Text="Connect IP" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Reboot Options Tool Card -->
                        <Border Style="{StaticResource FluentCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🔄 Device Reboot Options" Style="{StaticResource SubHeaderTextBlock}" />
                                <TextBlock Text="Reboot your Android device into specific system modes." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,12" />

                                <WrapPanel>
                                    <Button Style="{StaticResource FluentButton}" Command="{Binding RebootNormalCommand}" Margin="0,0,8,8">
                                        <TextBlock Text="Reboot System" FontSize="12" />
                                    </Button>
                                    <Button Style="{StaticResource FluentButton}" Command="{Binding RebootRecoveryCommand}" Margin="0,0,8,8">
                                        <TextBlock Text="Reboot Recovery" FontSize="12" />
                                    </Button>
                                    <Button Style="{StaticResource FluentButton}" Command="{Binding RebootBootloaderCommand}" Margin="0,0,8,8">
                                        <TextBlock Text="Reboot Bootloader" FontSize="12" />
                                    </Button>
                                    <Button Style="{StaticResource FluentButton}" Command="{Binding RebootEdlCommand}" Margin="0,0,0,8">
                                        <TextBlock Text="Reboot EDL (Qualcomm)" FontSize="12" />
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Screenshot & Capture Card -->
                        <Border Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <TextBlock Text="📸 Screen Capture" Style="{StaticResource SubHeaderTextBlock}" />
                                <TextBlock Text="Take instant high-resolution screenshots." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,12" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding TakeScreenshotCommand}" Margin="0,0,8,0">
                                        <TextBlock Text="Take Screenshot" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
