<UserControl x:Class="UnlockMatePro.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Interactive ADB Shell Terminal" Style="{StaticResource HeaderTextBlock}" />

        <!-- Toolbar Buttons -->
        <Border Grid.Row="1" Style="{StaticResource FluentCard}" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Target Device: " Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding TargetSerialNumber}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource FluentButton}" Command="{Binding ClearTerminalCommand}" Margin="0,0,6,0" Padding="10,4">
                        <TextBlock Text="Clear Console" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource FluentButton}" Command="{Binding CopyOutputCommand}" Margin="0,0,6,0" Padding="10,4">
                        <TextBlock Text="Copy Output" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveLogCommand}" Padding="12,4">
                        <TextBlock Text="Save Log File" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Terminal Console Output Window -->
        <Border Grid.Row="2" Style="{StaticResource FluentCard}" Padding="8" Margin="0,0,0,12" Background="{DynamicResource ConsoleBackgroundBrush}">
            <TextBox Text="{Binding TerminalOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource ConsoleForegroundBrush}"
                     Background="Transparent" BorderThickness="0" VerticalScrollBarVisibility="Auto" />
        </Border>

        <!-- Command Input Box -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding InputCommand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Tag="Enter ADB command (e.g., shell getprop, devices, pm list packages)..." Margin="0,0,8,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ExecuteCommand}" />
                    <KeyBinding Key="Up" Command="{Binding PreviousHistoryCommand}" />
                    <KeyBinding Key="Down" Command="{Binding NextHistoryCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}" Padding="20,8">
                <TextBlock Text="Execute" FontSize="14" />
            </Button>
        </Grid>
    </Grid>
</UserControl>

