<UserControl x:Class="UnlockMatePro.Views.ApkToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="APK Tools Suite &amp; Comparison" Style="{StaticResource HeaderTextBlock}" />

            <!-- APK Inspector & Rename Card -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <TextBlock Text="🔍 APK Signature &amp; Metadata Inspector" Style="{StaticResource SubHeaderTextBlock}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding InspectApkPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Tag="Select APK file to inspect..." Margin="0,0,8,0" />
                        <Button Grid.Column="1" Style="{StaticResource FluentButton}" Command="{Binding BrowseInspectApkCommand}" Margin="0,0,8,0">
                            <TextBlock Text="Browse APK..." />
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding InspectApkCommand}" Margin="0,0,8,0">
                            <TextBlock Text="Inspect Signature" />
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource FluentButton}" Command="{Binding OrganizeApkCommand}">
                            <TextBlock Text="Auto Rename File" />
                        </Button>
                    </Grid>

                    <TextBox Text="{Binding SignatureDetails}" IsReadOnly="True" AcceptsReturn="True" Height="140"
                             FontFamily="Consolas" FontSize="12" Background="{DynamicResource ConsoleBackgroundBrush}" Foreground="{DynamicResource SuccessBrush}" Padding="10" />
                </StackPanel>
            </Border>

            <!-- APK Comparison Card -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <TextBlock Text="⚖️ Side-by-Side APK Comparison" Style="{StaticResource SubHeaderTextBlock}" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CompareApkPath1, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Tag="First APK file..." Margin="0,0,8,0" />
                        <Button Grid.Column="1" Style="{StaticResource FluentButton}" Command="{Binding BrowseCompare1Command}">
                            <TextBlock Text="Browse APK 1" />
                        </Button>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CompareApkPath2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Tag="Second APK file..." Margin="0,0,8,0" />
                        <Button Grid.Column="1" Style="{StaticResource FluentButton}" Command="{Binding BrowseCompare2Command}">
                            <TextBlock Text="Browse APK 2" />
                        </Button>
                    </Grid>

                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CompareApksCommand}" HorizontalAlignment="Right" Padding="20,8" Margin="0,0,0,12">
                        <TextBlock Text="Compare APK Metadata" />
                    </Button>

                    <TextBox Text="{Binding ComparisonResult}" IsReadOnly="True" AcceptsReturn="True" Height="160"
                             FontFamily="Consolas" FontSize="12" Background="{DynamicResource ConsoleBackgroundBrush}" Foreground="{DynamicResource ConsoleForegroundBrush}" Padding="10" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

