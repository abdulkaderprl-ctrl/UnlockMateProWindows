<UserControl x:Class="UnlockMatePro.Views.ApkInstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Universal APK &amp; Split Bundle Installer" Style="{StaticResource HeaderTextBlock}" />

            <!-- Drag & Drop Zone Card -->
            <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" Padding="28" Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{DynamicResource IconApkInstall}" Fill="{DynamicResource AccentBrush}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Drag &amp; Drop APK or Split Archives Here" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Supports single .apk files and Split APK bundles (.apks, .xapk, .apkm)" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,16" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding BrowseApkCommand}" HorizontalAlignment="Center" Padding="20,10">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconApkInstall}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Browse Files (.apk, .xapk, .apks, .apkm)" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Install Preferences Card -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <TextBlock Text="Universal Installer Preferences &amp; Conflict Resolution" Style="{StaticResource SubHeaderTextBlock}" />
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox Content="Reinstall Existing Package (-r)" IsChecked="{Binding IsReinstall}" Margin="0,0,20,8" />
                        <CheckBox Content="Auto-Grant Runtime Permissions (-g)" IsChecked="{Binding GrantPermissions}" Margin="0,0,20,8" />
                        <CheckBox Content="Allow Version Downgrade (-d)" IsChecked="{Binding AllowDowngrade}" Margin="0,0,20,8" />
                        <CheckBox Content="Auto-Uninstall on Signature/Update Conflict" IsChecked="{Binding AutoUninstallOnConflict}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Selected APK Queue & Details -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Package Queue &amp; Diagnostics" Style="{StaticResource SubHeaderTextBlock}" VerticalAlignment="Center" Margin="0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource FluentButton}" Command="{Binding ClearQueueCommand}" Margin="0,0,8,0" Padding="12,6">
                                <TextBlock Text="Clear Queue" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding InstallAllCommand}" Padding="16,6">
                                <TextBlock Text="Install All Packages" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Queue List -->
                    <DataGrid ItemsSource="{Binding ApkQueue}" SelectedItem="{Binding SelectedApk}" AutoGenerateColumns="False"
                              IsReadOnly="True" RowHeight="36" HeadersVisibility="Column" Height="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding ExtensionBadge}" Width="60" />
                            <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*" />
                            <DataGridTextColumn Header="Package Name" Binding="{Binding PackageName}" Width="1.5*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="90" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Right">
                        <Button Style="{StaticResource FluentButton}" Command="{Binding UninstallPackageCommand}" Margin="0,0,8,0">
                            <TextBlock Text="Uninstall Existing Package" Foreground="{DynamicResource ErrorBrush}" />
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding InstallSingleCommand}">
                            <TextBlock Text="Install Selected Package" />
                        </Button>
                    </StackPanel>

                    <!-- Status Message & Progress Bar -->
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,0,0,6" />
                        <ProgressBar Value="{Binding OverallProgress}" Style="{StaticResource FluentProgressBar}" IsIndeterminate="{Binding IsInstalling}" Margin="0,0,0,12" />

                        <!-- Detailed ADB Diagnostic Stream Log -->
                        <TextBlock Text="ADB Installation Execution Stream Log:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DetailedLog}" IsReadOnly="True" AcceptsReturn="True" Height="120"
                                 FontFamily="Consolas" FontSize="11" Background="{DynamicResource ConsoleBackgroundBrush}" Foreground="{DynamicResource ConsoleForegroundBrush}" Padding="8" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>


