<UserControl x:Class="UnlockMatePro.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="System Dashboard &amp; Hardware Metrics" Style="{StaticResource HeaderTextBlock}" />

            <!-- Metrics Grid -->
            <UniformGrid Columns="2" Rows="2">

                <!-- ADB Status Card -->
                <Border Style="{StaticResource FluentCard}" Margin="0,0,10,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="#260078D4" Margin="0,0,16,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconTools}" Fill="{DynamicResource AccentBrush}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="ADB Status" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" />
                            <TextBlock Text="{Binding AdbStatus}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Connected Device Card -->
                <Border Style="{StaticResource FluentCard}" Margin="10,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="#26107C41" Margin="0,0,16,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDevice}" Fill="{DynamicResource SuccessBrush}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Connected Device" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" />
                            <TextBlock Text="{Binding DeviceStatus}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Android Version Card -->
                <Border Style="{StaticResource FluentCard}" Margin="0,0,10,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="#26D83B01" Margin="0,0,16,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconApps}" Fill="{DynamicResource WarningBrush}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Android OS Version" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" />
                            <TextBlock Text="{Binding AndroidVersion}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Battery Percentage Card -->
                <Border Style="{StaticResource FluentCard}" Margin="10,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="#260078D4" Margin="0,0,16,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBattery}" Fill="{DynamicResource AccentBrush}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Battery Level" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" />
                            <TextBlock Text="{Binding BatteryLevelText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

            </UniformGrid>

            <!-- RAM & Storage Gauges Card -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <TextBlock Text="📊 RAM &amp; Storage Usage Gauges" Style="{StaticResource SubHeaderTextBlock}" />

                    <TextBlock Text="{Binding SystemStats.RamUsagePercent, StringFormat='System RAM Usage (\{0:F1\}%)'}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,4" />
                    <ProgressBar Value="{Binding SystemStats.RamUsagePercent, Mode=OneWay}" Height="8" Style="{StaticResource FluentProgressBar}" Margin="0,0,0,12" />

                    <TextBlock Text="{Binding SystemStats.StorageUsagePercent, StringFormat='Internal Storage Usage (/sdcard) (\{0:F1\}%)'}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,4" />
                    <ProgressBar Value="{Binding SystemStats.StorageUsagePercent, Mode=OneWay}" Height="8" Style="{StaticResource FluentProgressBar}" />
                </StackPanel>
            </Border>

            <!-- Device Information Overview Card -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <TextBlock Text="📱 Device Diagnostics &amp; System Information" Style="{StaticResource SubHeaderTextBlock}" />
                    <TextBlock Text="{Binding SystemStats.BuildFingerprint, StringFormat='Build Fingerprint: \{0\}'}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,2,0,2" />
                    <TextBlock Text="{Binding SystemStats.SecurityPatch, StringFormat='Security Patch: \{0\}'}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,2,0,2" />
                    <TextBlock Text="{Binding SystemStats.IsRooted, StringFormat='Root Access: \{0\}'}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,2,0,2" />
                    <TextBlock Text="{Binding SystemStats.NetworkType, StringFormat='Network: \{0\}'}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,2,0,2" />
                    <TextBlock Text="{Binding SystemStats.BatteryTempCelsius, StringFormat='Battery Temp: \{0\}°C'}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,2,0,2" />
                </StackPanel>
            </Border>

            <!-- Live Log Card -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <TextBlock Text="📜 Live ADB Operations Log" Style="{StaticResource SubHeaderTextBlock}" />
                    <Border Background="#1E1E1E" CornerRadius="4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,8,0,0">
                        <ListBox ItemsSource="{Binding LiveLogs}" 
                                 Height="250" 
                                 Background="Transparent" 
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Header}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Details}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Visibility="{Binding Details, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#2A2A2A" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

