<UserControl x:Class="UnlockMatePro.Views.AdvancedToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Advanced Device Diagnostics &amp; Root Suite" Style="{StaticResource HeaderTextBlock}" />

            <!-- Hardware & System Information Summary Grid -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📱 Hardware &amp; System Information Summary" Style="{StaticResource SubHeaderTextBlock}" VerticalAlignment="Center" Margin="0" />
                        <Button Grid.Column="1" Style="{StaticResource FluentButton}" Command="{Binding RefreshDiagnosticsCommand}" Padding="12,4">
                            <TextBlock Text="Refresh Hardware Info" FontSize="12" />
                        </Button>
                    </Grid>

                    <UniformGrid Columns="2" Rows="5">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Brand: " Foreground="{DynamicResource SecondaryTextBrush}" Width="120" />
                            <TextBlock Text="{Binding Brand}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Model: " Foreground="{DynamicResource SecondaryTextBrush}" Width="120" />
                            <TextBlock Text="{Binding Model}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Android Version: " Foreground="{DynamicResource SecondaryTextBrush}" Width="120" />
                            <TextBlock Text="{Binding AndroidVersion}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="SDK API Level: " Foreground="{DynamicResource SecondaryTextBrush}" Width="120" />
                            <TextBlock Text="{Binding SdkVersion}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Build Number: " Foreground="{DynamicResource SecondaryTextBrush}" Width="120" />
                            <TextBlock Text="{Binding BuildNumber}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="CPU Architecture: " Foreground="{DynamicResource SecondaryTextBrush}" Width="120" />
                            <TextBlock Text="{Binding CpuAbi}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Serial Number: " Foreground="{DynamicResource SecondaryTextBrush}" Width="120" />
                            <TextBlock Text="{Binding SerialNumberDisplay}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Battery Level: " Foreground="{DynamicResource SecondaryTextBrush}" Width="120" />
                            <TextBlock Text="{Binding BatteryLevelText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Internal Storage: " Foreground="{DynamicResource SecondaryTextBrush}" Width="120" />
                            <TextBlock Text="{Binding StorageStatsText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="System RAM: " Foreground="{DynamicResource SecondaryTextBrush}" Width="120" />
                            <TextBlock Text="{Binding RamStatsText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Root & Security Diagnostics Card -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <TextBlock Text="🛡️ Root Access, Superuser &amp; Security Diagnostics" Style="{StaticResource SubHeaderTextBlock}" />

                    <UniformGrid Columns="2" Rows="3" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="Root Access: " Foreground="{DynamicResource SecondaryTextBrush}" Width="140" />
                            <TextBlock Text="{Binding RootStatusText}" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="Magisk Detection: " Foreground="{DynamicResource SecondaryTextBrush}" Width="140" />
                            <TextBlock Text="{Binding MagiskStatusText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="SuperSU Binary: " Foreground="{DynamicResource SecondaryTextBrush}" Width="140" />
                            <TextBlock Text="{Binding SuperSuStatusText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="BusyBox Binary: " Foreground="{DynamicResource SecondaryTextBrush}" Width="140" />
                            <TextBlock Text="{Binding BusyBoxStatusText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="SELinux State: " Foreground="{DynamicResource SecondaryTextBrush}" Width="140" />
                            <TextBlock Text="{Binding SELinuxStatusText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="dm-verity Mode: " Foreground="{DynamicResource SecondaryTextBrush}" Width="140" />
                            <TextBlock Text="{Binding DmVerityStatusText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Advanced Reboot Control Suite -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <TextBlock Text="⚡ Advanced Power &amp; Reboot Control Suite" Style="{StaticResource SubHeaderTextBlock}" />

                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding RebootSystemCommand}" Margin="0,0,10,8" Padding="16,6">
                            <TextBlock Text="Reboot System" FontSize="12" />
                        </Button>

                        <Button Style="{StaticResource FluentButton}" Command="{Binding RebootRecoveryCommand}" Margin="0,0,10,8" Padding="14,6">
                            <TextBlock Text="Reboot Recovery" FontSize="12" />
                        </Button>

                        <Button Style="{StaticResource FluentButton}" Command="{Binding RebootBootloaderCommand}" Margin="0,0,10,8" Padding="14,6">
                            <TextBlock Text="Reboot Bootloader" FontSize="12" />
                        </Button>

                        <Button Style="{StaticResource FluentButton}" Command="{Binding RebootFastbootDCommand}" Margin="0,0,10,8" Padding="14,6">
                            <TextBlock Text="Reboot FastbootD" FontSize="12" />
                        </Button>

                        <Button Style="{StaticResource FluentButton}" Command="{Binding RebootSafeModeCommand}" Margin="0,0,10,8" Padding="14,6">
                            <TextBlock Text="Reboot Safe Mode" Foreground="{DynamicResource WarningBrush}" FontSize="12" />
                        </Button>

                        <Button Style="{StaticResource FluentButton}" Command="{Binding RebootSideloadCommand}" Margin="0,0,0,8" Padding="14,6">
                            <TextBlock Text="Reboot Sideload Mode" FontSize="12" />
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

