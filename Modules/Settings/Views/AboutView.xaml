<UserControl x:Class="UnlockMatePro.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600" Margin="0,20,0,20">

            <!-- Logo & Brand Header -->
            <Border Style="{StaticResource FluentCard}" Padding="30" Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="80" Height="80" CornerRadius="40" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="⚡" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                    </Border>
                    <TextBlock Text="Unlock Mate Pro" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="Professional Universal Android Utility &amp; Flashing Suite" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Application Details Grid -->
            <Border Style="{StaticResource FluentCard}" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Application Release Specifications" Style="{StaticResource SubHeaderTextBlock}" Margin="0,0,0,16" />

                    <UniformGrid Columns="2" Rows="6">
                        <TextBlock Text="App Version:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6" />
                        <TextBlock Text="v1.0.0 Pro (Production)" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" Margin="0,6" />

                        <TextBlock Text="Build Date:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6" />
                        <TextBlock Text="2026-07-25" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" Margin="0,6" />

                        <TextBlock Text=".NET Runtime:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6" />
                        <TextBlock Text=".NET 8.0 (x64 Windows WPF)" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" Margin="0,6" />

                        <TextBlock Text="License Tier:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6" />
                        <TextBlock Text="Commercial Enterprise License" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" Margin="0,6" />

                        <TextBlock Text="Official Website:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6" />
                        <TextBlock Text="https://unlockmatepro.com" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,6" />

                        <TextBlock Text="GitHub Repository:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6" />
                        <TextBlock Text="github.com/unlockmatepro/app" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,6" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Copyright & Credits -->
            <TextBlock Text="© 2026 Unlock Mate Pro Technologies. All Rights Reserved." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

