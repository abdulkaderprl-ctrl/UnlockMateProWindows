<UserControl x:Class="UnlockMatePro.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="440" Margin="0,20">
            <Border Style="{StaticResource FluentCard}" Padding="28">
                <StackPanel>
                    <!-- Brand Header -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Path Data="{StaticResource IconApkInstall}" Fill="{DynamicResource AccentBrush}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Unlock Mate Pro" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Sign in to sync license and device tools" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Auth Tab Switcher -->
                    <UniformGrid Columns="2" Margin="0,0,0,20">
                        <Button Style="{StaticResource FluentButton}" Command="{Binding SwitchTabCommand}" CommandParameter="Login" Margin="0,0,4,0">
                            <TextBlock Text="Sign In" FontWeight="Bold" />
                        </Button>
                        <Button Style="{StaticResource FluentButton}" Command="{Binding SwitchTabCommand}" CommandParameter="Register" Margin="4,0,0,0">
                            <TextBlock Text="Register" FontWeight="Bold" />
                        </Button>
                    </UniformGrid>

                    <!-- Status Message Banner -->
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <!-- LOGIN TAB CONTENT -->
                    <StackPanel Visibility="{Binding IsLoginTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Email Address:" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Margin="0,0,0,14" />

                        <TextBlock Text="Password:" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,16">
                            <CheckBox Content="Remember Me &amp; Auto Login" IsChecked="{Binding RememberMe}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource FluentButton}" Command="{Binding SwitchTabCommand}" CommandParameter="ForgotPassword" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="0">
                                <TextBlock Text="Forgot Password?" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
                            </Button>
                        </Grid>

                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}" Padding="0,10" Margin="0,0,0,12">
                            <TextBlock Text="Sign In to Unlock Mate Pro" FontSize="14" />
                        </Button>
                    </StackPanel>

                    <!-- REGISTER TAB CONTENT -->
                    <StackPanel Visibility="{Binding IsRegisterTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Full Name:" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Margin="0,0,0,12" />

                        <TextBlock Text="Email Address:" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Margin="0,0,0,12" />

                        <TextBlock Text="Password:" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Margin="0,0,0,12" />

                        <TextBlock Text="Confirm Password:" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Margin="0,0,0,16" />

                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding RegisterCommand}" Padding="0,10" Margin="0,0,0,12">
                            <TextBlock Text="Create Account" FontSize="14" />
                        </Button>
                    </StackPanel>

                    <!-- FORGOT PASSWORD TAB CONTENT -->
                    <StackPanel Visibility="{Binding IsForgotPasswordTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Enter your registered email address to receive password reset instructions:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <TextBlock Text="Email Address:" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Margin="0,0,0,16" />

                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ForgotPasswordCommand}" Padding="0,10" Margin="0,0,0,12">
                            <TextBlock Text="Send Password Reset Link" FontSize="14" />
                        </Button>
                    </StackPanel>

                    <!-- Loading Progress -->
                    <ProgressBar IsIndeterminate="True" Height="4" Style="{StaticResource FluentProgressBar}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

