<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Windows 11 Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#EAEAEA" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#F8F8F8" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5C5C5C" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8C8C8C" />

    <!-- Interactive & Control Brushes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="NavSelectedBackgroundBrush" Color="#1A0078D4" />
    <SolidColorBrush x:Key="NavSelectedIndicatorBrush" Color="#0078D4" />

    <!-- Input Brushes -->
    <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBoxForegroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="TextBoxBorderBrush" Color="#CCCCCC" />

    <!-- ComboBox Brushes -->
    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxForegroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="ComboBoxPopupBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxItemHoverBrush" Color="#F0F0F0" />

    <!-- DataGrid Brushes -->
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DataGridRowAlternateBackgroundBrush" Color="#F9F9F9" />
    <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="DataGridRowSelectedForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#E0E0E0" />

    <!-- Accent Brushes -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1086E8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#005A9E" />

    <!-- Status Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#107C41" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D83B01" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#D13438" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0078D4" />

    <!-- Console Terminal Brushes -->
    <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ConsoleForegroundBrush" Color="#60CDFF" />

</ResourceDictionary>

