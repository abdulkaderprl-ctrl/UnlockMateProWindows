<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Windows 11 Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#181818" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9E9E9E" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#666666" />

    <!-- Interactive & Control Brushes -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#252525" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#333333" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#444444" />
    <SolidColorBrush x:Key="NavSelectedBackgroundBrush" Color="#260078D4" />
    <SolidColorBrush x:Key="NavSelectedIndicatorBrush" Color="#0078D4" />

    <!-- Input Brushes -->
    <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="#252525" />
    <SolidColorBrush x:Key="TextBoxForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBoxBorderBrush" Color="#3D3D3D" />

    <!-- ComboBox Brushes -->
    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="#252525" />
    <SolidColorBrush x:Key="ComboBoxForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxPopupBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ComboBoxItemHoverBrush" Color="#383838" />

    <!-- DataGrid Brushes -->
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#262626" />
    <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="DataGridRowAlternateBackgroundBrush" Color="#242424" />
    <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="DataGridRowSelectedForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#333333" />

    <!-- Accent Brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1086E8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#005A9E" />

    <!-- Status Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#107C41" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D83B01" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#E81123" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0078D4" />

    <!-- Console Terminal Brushes -->
    <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#141414" />
    <SolidColorBrush x:Key="ConsoleForegroundBrush" Color="#60CDFF" />

</ResourceDictionary>
