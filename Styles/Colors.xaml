<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 Accent Colors -->
    <Color x:Key="SystemAccentColor">#0078D4</Color>
    <Color x:Key="SystemAccentLightColor">#479EF5</Color>
    <Color x:Key="SystemAccentDarkColor">#005A9E</Color>
    <Color x:Key="SystemSuccessColor">#107C41</Color>
    <Color x:Key="SystemWarningColor">#D83B01</Color>
    <Color x:Key="SystemErrorColor">#A80000</Color>

    <!-- Dark Theme Palette -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#181818" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9E9E9E" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#666666" />
    
    <!-- Interactive Brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1086E8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#005A9E" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#333333" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#444444" />
    <SolidColorBrush x:Key="NavSelectedBackgroundBrush" Color="#2D3238" />
    <SolidColorBrush x:Key="NavSelectedIndicatorBrush" Color="#0078D4" />

    <!-- Status Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#107C41" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D83B01" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#E81123" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0078D4" />

    <!-- Glassmorphic Gradients -->
    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#333333" Offset="0.0" />
        <GradientStop Color="#262626" Offset="1.0" />
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0078D4" Offset="0.0" />
        <GradientStop Color="#005A9E" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
