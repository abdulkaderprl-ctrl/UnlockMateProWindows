<UserControl x:Class="AdbEasyInstaller.Views.UserProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="User Profile &amp; Account Management" Style="{StaticResource HeaderTextBlock}" />

            <!-- User Header Card -->
            <Border Style="{StaticResource FluentCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Avatar Badge -->
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32" Background="{DynamicResource AccentBrush}" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUser.InitialLetter}" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentUser.FullName}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0" />
                            <Border Background="#26107C41" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUser.PlanName}" Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentUser.Email}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource FluentButton}" Command="{Binding LogoutCommand}" VerticalAlignment="Center">
                        <TextBlock Text="Sign Out" Foreground="{DynamicResource ErrorBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Subscription Details Card -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <TextBlock Text="License &amp; Subscription Info" Style="{StaticResource SubHeaderTextBlock}" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Account Plan:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentUser.PlanName}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Subscription Status:" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Active (Full Unlocks Granted)" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Expiration Date:" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentUser.SubscriptionExpiresAt, StringFormat='{}{0:yyyy-MM-dd}'}" Foreground="{DynamicResource PrimaryTextBrush}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
