<Window x:Class="UnlockMatePro.Views.FilePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Properties" Height="360" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundBrush}">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Icon & Name -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock x:Name="TxtIcon" Text="📄" FontSize="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtItemName" Text="Filename.ext" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                    <TextBlock x:Name="TxtItemType" Text="File Category" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>

            <Separator Grid.Row="0" VerticalAlignment="Bottom" Margin="0,0,0,8" />

            <!-- Detailed Properties Grid -->
            <Grid Grid.Row="1" Margin="0,8,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Full Path:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtFullPath" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="NoWrap" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Size:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtSize" Text="0 Bytes" Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Modified:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtDate" Text="N/A" Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Permissions:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtPermissions" Text="rw-rw----" Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Owner:" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtOwner" Text="root" Foreground="{DynamicResource PrimaryTextBrush}" />
            </Grid>

            <!-- Close Button -->
            <Button Grid.Row="2" Content="Close" Style="{StaticResource FluentButton}" Width="100" HorizontalAlignment="Right" Click="CloseButton_Click" Height="32" />
        </Grid>
    </Border>
</Window>

