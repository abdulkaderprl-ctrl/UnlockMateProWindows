<UserControl x:Class="UnlockMatePro.Views.DeviceDetectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Device Detection" Style="{StaticResource HeaderTextBlock}" VerticalAlignment="Center" Margin="0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource FluentButton}" Command="{Binding AutoDetectAdbCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTools}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Auto Detect ADB" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="Refresh Devices" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Active ADB Path Display -->
            <Border Style="{StaticResource FluentCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Active ADB Executable:" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding AdbPathText}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <!-- Detected Devices List -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <TextBlock Text="Connected Devices" Style="{StaticResource SubHeaderTextBlock}" />

                    <!-- Empty State -->
                    <Border Visibility="{Binding HasDevices, ConverterParameter=Invert, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Padding="32" Background="#222222" CornerRadius="6" Margin="0,8,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconDevice}" Fill="{StaticResource SecondaryTextBrush}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock Text="No Device Connected" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            <TextBlock Text="Plug in your Android phone via USB and enable USB Debugging." Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Devices Table -->
                    <ItemsControl ItemsSource="{Binding Devices}" Visibility="{Binding HasDevices, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#252525" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconDevice}" Fill="{StaticResource AccentBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="White" FontSize="14" />
                                            <TextBlock Text="{Binding AndroidVersion, StringFormat='Android Version: {0}'}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#26107C41" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeviceState}" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Guide Card for Non-Technical Users -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <TextBlock Text="💡 How to Enable USB Debugging on Android" Style="{StaticResource SubHeaderTextBlock}" />
                    <TextBlock Text="1. Open Settings on your Android device." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,2" />
                    <TextBlock Text="2. Go to 'About Phone' and tap 'Build Number' 7 times until Developer options are unlocked." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,2" />
                    <TextBlock Text="3. Go back to Settings > System > Developer Options." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,2" />
                    <TextBlock Text="4. Turn on 'USB Debugging' and accept the USB prompt on your phone screen." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,2" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

