<UserControl x:Class="UnlockMatePro.Views.ApkManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Package &amp; APK Management" Style="{StaticResource HeaderTextBlock}" VerticalAlignment="Center" Margin="0" />
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshAppsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh Packages" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Search & Filters Toolbar -->
            <Border Style="{StaticResource FluentCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Tag="Search installed packages..." Margin="0,0,16,0" />
                    <CheckBox Grid.Column="1" Content="Include System Apps" IsChecked="{Binding IncludeSystemApps}" Foreground="White" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Installed Apps DataGrid -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <DataGrid ItemsSource="{Binding FilteredApps}" SelectedItem="{Binding SelectedApp}" AutoGenerateColumns="False"
                              IsReadOnly="True" Background="#222222" Foreground="White" BorderBrush="{StaticResource CardBorderBrush}" Height="340" RowHeight="36" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Package Identifier" Binding="{Binding PackageName}" Width="*" />
                            <DataGridTextColumn Header="Category" Binding="{Binding AppCategory}" Width="120" />
                            <DataGridTextColumn Header="Device Path" Binding="{Binding ApkPath}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Action Bar -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource FluentButton}" Command="{Binding BackupApkCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconApkInstall}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Backup APK to PC" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FluentButton}" Command="{Binding UninstallAppCommand}">
                            <TextBlock Text="Uninstall Package" Foreground="{StaticResource ErrorBrush}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

