<UserControl x:Class="AdbEasyInstaller.Views.AdbToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="ADB Utility Tools" Style="{StaticResource HeaderTextBlock}" />

            <!-- Grid of Tools -->
            <UniformGrid Columns="2">

                <!-- Wireless ADB Tool Card -->
                <Border Style="{StaticResource FluentCard}" Margin="0,0,10,12">
                    <StackPanel>
                        <TextBlock Text="📶 Enable Wireless ADB" Style="{StaticResource SubHeaderTextBlock}" />
                        <TextBlock Text="Enable TCP/IP mode and connect wirelessly without USB cables." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource FluentButton}" Command="{Binding EnableWirelessAdbCommand}" Margin="0,0,8,0">
                                <TextBlock Text="Enable TCPIP Mode" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConnectWirelessAdbCommand}">
                                <TextBlock Text="Connect IP" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Reboot Options Tool Card -->
                <Border Style="{StaticResource FluentCard}" Margin="10,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🔄 Device Reboot Options" Style="{StaticResource SubHeaderTextBlock}" />
                        <TextBlock Text="Reboot your Android device into specific system modes." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,12" />

                        <WrapPanel>
                            <Button Style="{StaticResource FluentButton}" Command="{Binding RebootNormalCommand}" Margin="0,0,8,8">
                                <TextBlock Text="Reboot System" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource FluentButton}" Command="{Binding RebootRecoveryCommand}" Margin="0,0,8,8">
                                <TextBlock Text="Reboot Recovery" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource FluentButton}" Command="{Binding RebootBootloaderCommand}" Margin="0,0,0,8">
                                <TextBlock Text="Reboot Bootloader" FontSize="12" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Screenshot & Capture Card -->
                <Border Style="{StaticResource FluentCard}" Margin="0,0,10,12">
                    <StackPanel>
                        <TextBlock Text="📸 Capture &amp; Storage" Style="{StaticResource SubHeaderTextBlock}" />
                        <TextBlock Text="Take instant high-resolution screenshots or explore local device files." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding TakeScreenshotCommand}" Margin="0,0,8,0">
                                <TextBlock Text="Take Screenshot" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource FluentButton}" Command="{Binding OpenStorageCommand}">
                                <TextBlock Text="Open Workspace Folder" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Device Logcat Viewer Card -->
                <Border Style="{StaticResource FluentCard}" Margin="10,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📋 Live Logcat Stream" Style="{StaticResource SubHeaderTextBlock}" />
                        <TextBlock Text="Retrieve real-time Android system log output." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,12" />

                        <Button Style="{StaticResource FluentButton}" Command="{Binding FetchLogcatCommand}" HorizontalAlignment="Left">
                            <TextBlock Text="Fetch Logcat Output" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Logcat Output Display Console -->
            <Border Style="{StaticResource FluentCard}">
                <StackPanel>
                    <TextBlock Text="Logcat Console Output" Style="{StaticResource SubHeaderTextBlock}" />
                    <TextBox Text="{Binding LogcatOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Height="180" FontFamily="Consolas" FontSize="12" Background="#161616" Foreground="#88D8B0" Padding="12" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
