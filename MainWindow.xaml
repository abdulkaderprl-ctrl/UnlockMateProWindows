<Window x:Class="UnlockMatePro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UnlockMatePro.ViewModels"
        xmlns:views="clr-namespace:UnlockMatePro.Views"
        xmlns:conv="clr-namespace:UnlockMatePro.Converters"
        Title="Unlock Mate Pro - Professional Android Device Manager" Height="780" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding NavigateCommand}" CommandParameter="Logs" />
    </Window.InputBindings>
    <Window.Resources>
        <!-- Data Templates mapping ViewModels to Views -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceDetectionViewModel}">
            <views:DeviceDetectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ApkInstallViewModel}">
            <views:ApkInstallView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileExplorerViewModel}">
            <views:FileExplorerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PhoneCloneViewModel}">
            <views:PhoneCloneView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupRestoreViewModel}">
            <views:BackupRestoreView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TerminalViewModel}">
            <views:TerminalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScreenshotGalleryViewModel}">
            <views:ScreenshotGalleryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ApkToolsViewModel}">
            <views:ApkToolsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdvancedToolsViewModel}">
            <views:AdvancedToolsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScrcpyViewModel}">
            <views:ScrcpyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FastbootToolsViewModel}">
            <views:FastbootToolsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdbToolsViewModel}">
            <views:AdbToolsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ApkManagementViewModel}">
            <views:ApkManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuthViewModel}">
            <views:AuthView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserProfileViewModel}">
            <views:UserProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BrandPlaceholderViewModel}">
            <views:BrandPlaceholderView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconApkInstall}" Fill="{DynamicResource AccentBrush}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0" />
                    <TextBlock Text="Unlock Mate Pro" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Device Selector & Status Center -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- ADB Status Indicator Badge -->
                    <Border Background="#260078D4" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AdbStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Target Device ComboBox -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Active Device:" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" />
                        <ComboBox Width="240" Height="32" ItemsSource="{Binding ConnectedDevices}" SelectedItem="{Binding SelectedDevice}"
                                  DisplayMemberPath="DisplayName" Padding="8,4" Background="{DynamicResource ComboBoxBackgroundBrush}" Foreground="{DynamicResource ComboBoxForegroundBrush}" />
                        <Button Style="{StaticResource FluentButton}" Command="{Binding RefreshDevicesCommand}" Margin="8,0,0,0" Width="36" Height="32" Padding="0" ToolTip="Refresh Connected Devices (Ctrl+R)">
                            <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource PrimaryTextBrush}" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- User Account & Theme Switcher -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- User Profile / Login Button -->
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenAccountCommand}" Margin="0,0,8,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤 " FontSize="12" />
                            <TextBlock Text="{Binding UserFullName}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource FluentButton}" Command="{Binding ToggleThemeCommand}" ToolTip="Toggle Light/Dark Theme" Padding="10,6">
                        <TextBlock Text="Theme 🌙" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top Brand Menu Ribbon -->
        <Border Grid.Row="1" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                <StackPanel Orientation="Horizontal" Margin="12,8">
                    <!-- Brand Buttons -->
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Content="DASHBOARD" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='Dashboard'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="AdbTools" Content="ADB" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='AdbTools'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="FastbootTools" Content="FASTBOOT" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='FastbootTools'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="FRP" Content="FRP" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='FRP'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="Samsung" Content="SAMSUNG" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='Samsung'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="Xiaomi" Content="XIAOMI" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='Xiaomi'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="OPPO" Content="OPPO" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='OPPO'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="VIVO" Content="VIVO" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='VIVO'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="Realme" Content="REALME" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='Realme'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="Huawei" Content="HUAWEI" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='Huawei'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="Honor" Content="HONOR" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='Honor'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="Motorola" Content="MOTOROLA" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='Motorola'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="Nokia" Content="NOKIA" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='Nokia'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="Qualcomm" Content="QUALCOMM" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='Qualcomm'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="MTK" Content="MTK" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='MTK'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="SPD" Content="SPD" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='SPD'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="Apple" Content="APPLE" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='Apple'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="BackupRestore" Content="BACKUP" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='BackupRestore'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="PhoneClone" Content="PHONE CLONE" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='PhoneClone'}" />
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="FileExplorer" Content="FILE EXPLORER" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='FileExplorer'}" />
                    
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,4" />
                    
                    <Button Style="{StaticResource BrandMenuButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings" Content="SETTINGS" Tag="{Binding ActiveViewName, Converter={StaticResource EqualityConverter}, ConverterParameter='Settings'}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Main Content Container -->
        <Grid Grid.Row="2">
            <ContentControl Content="{Binding CurrentViewModel}" Margin="20" />

                <!-- Toast Notification Banner -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Width="340"
                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="16"
                        Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding ToastTitle}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding ToastMessage}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource FluentButton}" Command="{Binding DismissToastCommand}"
                                Content="✕" Padding="6,2" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" />
                    </Grid>
                </Border>
        </Grid>
    </Grid>
</Window>

